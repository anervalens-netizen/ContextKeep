[Unit]
Description=Read-only ContextKeep SQLite capacity observation
After=local-fs.target
ConditionPathExists=/etc/default/contextkeep-capacity-sample

[Service]
Type=oneshot
User=%i
Group=%i
EnvironmentFile=/etc/default/contextkeep-capacity-sample
ExecStart=/usr/bin/python3 -B /usr/local/libexec/contextkeep/capacity-sample.py
TimeoutStartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
PrivateDevices=true
RestrictSUIDSGID=true
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
MemoryMax=128M
CPUQuota=20%
