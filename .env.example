# ContextKeep local configuration. Copy to .env (untracked). Never commit secrets.
# Set NODE_ENV=production for production runs (quieter logs).
NODE_ENV=production
CK_DATA_DIR=./data
CK_PORT=3082
CK_HOST=127.0.0.1
CK_SESSION_SECRET=change-me
# Optional exact release Git SHA exposed read-only by /api/meta. Release automation sets this.
CK_BUILD_SHA=
# Optional private MCP local bearer, 32+ characters. Blank disables /mcp.
# Prefer a separate protected service EnvironmentFile; see docs/contextkeep-mcp.md.
CK_MCP_TOKEN=
# Proposal-only delegated working memory. Enabling delegation requires a stable default identity.
# Shared-endpoint callers may override attribution per capture with clientId=chatgpt|codex|dsh.
CK_MCP_DEFAULT_CLIENT_ID=
CK_MCP_DELEGATE_WORKING_MEMORY=false
CK_COOKIE_SECURE=true
CK_BACKUP_DIR=./backups
CK_BACKUP_KEEP=14
CK_ADAPTERS=manual,faketest

# M3.1 workspace discovery.
CK_WORKSPACE_ROOTS=
CK_WORKSPACE_SCAN_MAX_DEPTH=6
CK_WORKSPACE_GITHUB_OWNER=

# M3.2/M3.3 local agent stores.
CK_CODEX_HOME=
CK_DSH_HOME=

# Bounded sync/backfill. Scheduled sync is intentionally disabled by default.
CK_SYNC_INTERVAL_MINUTES=0
CK_SYNC_IDLE_MINUTES=30
CK_SYNC_MAX_ARTIFACTS=25
CK_SYNC_MAX_CHARS=1000000
CK_SYNC_MAX_COST_USD=0.25
CK_SYNC_EXTRACTION_ADAPTER=deepseek
CK_SYNC_ALLOW_UNASSIGNED_ARCHIVE=false

# L5.4 safe periodic memory housekeeping; 0 disables scheduling.
CK_HOUSEKEEPING_INTERVAL_MINUTES=0
CK_HOUSEKEEPING_PROPOSAL_RETENTION_DAYS=30

CK_COST_CEILING_USD=0.05
CK_VOLATILE_REVIEW_INTERVAL_DAYS=7

# --- DeepSeek primary extraction provider ----------------------------------
# DEEPSEEK_API_KEY=<injected by mode-0600 systemd EnvironmentFile>
CK_DEEPSEEK_MODEL=deepseek-flash
CK_DEEPSEEK_BASE_URL=https://api.deepseek.com
CK_DEEPSEEK_THINKING=on
CK_DEEPSEEK_REASONING_EFFORT=max
CK_DEEPSEEK_TIMEOUT_MS=120000
CK_DEEPSEEK_MAX_OUTPUT_TOKENS=32768
CK_DEEPSEEK_MAX_INPUT_CHARS=200000
CK_DEEPSEEK_INPUT_USD_PER_MTOK=0.44
CK_DEEPSEEK_INPUT_CACHE_HIT_USD_PER_MTOK=0.014
CK_DEEPSEEK_OUTPUT_USD_PER_MTOK=1.32

# Provider credentials belong in a separate mode-0600 systemd EnvironmentFile,
# never this tracked example, the browser bundle, logs, or documentation.
# OPENAI_API_KEY=<injected by systemd EnvironmentFile>
# DEEPSEEK_API_KEY=<injected by systemd EnvironmentFile>

# SQLite durability: production defaults FULL; development/test defaults NORMAL.
# FULL adds a WAL sync per committed transaction; benchmark on the release host.
# CK_SQLITE_SYNCHRONOUS=FULL
