{
  "name": "@contextkeep/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=.env --import tsx/esm src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run --exclude '**/perf.test.ts'",
    "test:perf": "vitest run test/perf.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx/esm src/cli/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx/esm src/cli/seed.ts",
    "db:seed-from-dump": "node --env-file-if-exists=.env --import tsx/esm src/cli/seed-from-dump.ts",
    "eval:ai-memory": "node --import tsx/esm scripts/ai-memory-eval.ts",
    "backup": "node --env-file-if-exists=.env --import tsx/esm src/cli/backup.ts",
    "restore": "node --env-file-if-exists=.env --import tsx/esm src/cli/restore.ts"
  },
  "dependencies": {
    "@contextkeep/shared": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "prom-client": "15.1.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "vitest": "5.0.0"
  }
}
